{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "office": {
            "type": "local",
            "command": ["uvx", "mcp-server-office"],
            "enabled": true
        },

        "excel": {
            "type": "local",
            "command": [
                "cmd",
                "/c",
                "npx",
                "--yes",
                "@negokaz/excel-mcp-server"
            ],
            "environment": {
                "EXCEL_MCP_PAGING_CELLS_LIMIT": "4000"
            },
            "enabled": true
        }
    }
}
